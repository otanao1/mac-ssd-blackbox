// Team is intentionally unset. Select a signing team only after user confirmation.
// A local override is ignored by Git and must never contain monitoring paths/data.
BLACKBOX_BUNDLE_ID = io.github.otanao1.blackbox-viewer
BLACKBOX_DISPLAY_NAME = Blackbox Viewer
BLACKBOX_WIDGET_DISPLAY_NAME = BlackboxWidget
BLACKBOX_WIDGET_TITLE = SSD空き容量
BLACKBOX_URL_SCHEME = blackbox-viewer
BLACKBOX_WIDGET_KIND = BlackboxL1Widget
BLACKBOX_BUILD_VERSION = 3
BLACKBOX_MARKETING_VERSION = 0.1
BLACKBOX_APP_GROUP = $(DEVELOPMENT_TEAM).$(BLACKBOX_BUNDLE_ID)
#include? "Local.xcconfig"
